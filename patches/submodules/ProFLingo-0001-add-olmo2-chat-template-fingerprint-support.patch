-def select_prompt(models, tokenizer, executor,system_ids_lst, prompt_ids, prompt_replace_lst, filter_word, previous_loss):  
+def _roundtrip_ids(tokenizer, decoded_str, use_tokenizer_template=False):
+    if use_tokenizer_template:
+        return tokenizer.encode(decoded_str, add_special_tokens=False)
+    return tokenizer.encode(decoded_str)[2:]
+
+
+def select_prompt(models, tokenizer, executor,system_ids_lst, prompt_ids, prompt_replace_lst, filter_word, previous_loss, use_tokenizer_template=False):  
 
     filtered_lst = prompt_replace_lst.tolist().copy()
 
