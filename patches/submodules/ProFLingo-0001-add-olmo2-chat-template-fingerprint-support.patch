             cand_prompt_ids = prompt_ids.tolist()
             cand_prompt_ids[i] = repl_token
             decoded_str = tokenizer.decode(cand_prompt_ids)
-            if (cand_prompt_ids != tokenizer.encode(decoded_str)[2:] or filter_word in decoded_str.lower()):
+            if (cand_prompt_ids != _roundtrip_ids(tokenizer, decoded_str, use_tokenizer_template) or filter_word in decoded_str.lower()):
                 filtered_lst[i].remove(repl_token)
 
     index_lst = [(i, j) for i, sublst in enumerate(filtered_lst) for j, _ in enumerate(sublst)]
@@ -115,7 +121,7 @@ def select_prompt(models, tokenizer, executor,system_ids_lst, prompt_ids, prompt
             for system_ids in system_ids_lst:
                 loss += get_loss_from_ids(models, executor, system_ids, prompt_ids).item()
 
-            if ((loss < new_loss or new_prompt == None) and (prompt_ids.tolist() == tokenizer.encode(tokenizer.decode(prompt_ids))[2:])):
+            if ((loss < new_loss or new_prompt == None) and (prompt_ids.tolist() == _roundtrip_ids(tokenizer, tokenizer.decode(prompt_ids), use_tokenizer_template))):
                 #print(f"{loss=} {tokenizer.decode(old_id)} -> {tokenizer.decode(prompt_ids[prompt_index])}")
                 new_prompt = prompt_ids.clone()
                 new_loss = loss
@@ -168,10 +174,35 @@ def cal_replacable_ids(model, system_ids_lst, prompt_ids, repl_ids):
 def assemble_ids(tokenizer, template, question, target):  
     def find_ids(fst_ids, sed_ids):
         length = len(sed_ids)
-        for index in range(len(input_ids) - length + 1):
+        for index in range(len(fst_ids) - length + 1):
             if fst_ids[index:index+length] == sed_ids:
                 return index
         raise ValueError("Cannot find ids")
+
+    def encode_no_special(text):
+        return tokenizer.encode(text, add_special_tokens=False)
+
+    if (template == None):
+        sentinel_base = "<|proflingo_optimized_suffix_sentinel|>"
+        sentinel = sentinel_base
+        sentinel_index = 0
+        while sentinel in question or sentinel in target:
+            sentinel_index += 1
+            sentinel = f"{sentinel_base}_{sentinel_index}"
+
+        full_prompt = tokenizer.apply_chat_template(
+            [{"role": "user", "content": sentinel + question}],
+            tokenize=False,
+            add_generation_prompt=True,
+        )
+        sentinel_pos = full_prompt.find(sentinel)
+        if (sentinel_pos == -1 or full_prompt.find(sentinel, sentinel_pos + len(sentinel)) != -1):
+            raise ValueError("Cannot uniquely locate optimized suffix sentinel")
+
+        begin_ids = encode_no_special(full_prompt[:sentinel_pos])
+        middle_ids = encode_no_special(full_prompt[sentinel_pos + len(sentinel):])
+        target_ids = encode_no_special(target)
+        return begin_ids, middle_ids, target_ids
     
     template.messages = []
 
@@ -228,11 +259,12 @@ def generate_suffix(models, tokenizer, template_lst, question, target, num_epoch
     torch.manual_seed(seed)
 
     repl_ids = get_replacable_ids(tokenizer, filter_word, device=model.device)
+    use_tokenizer_template = any(template == None for template in template_lst)
 
     while True:
         prompt_ids = repl_ids[torch.randperm(len(repl_ids), device=model.device)[:token_nums]]
         decoded_str = tokenizer.decode(prompt_ids)
-        if (prompt_ids.tolist() == tokenizer.encode(decoded_str)[2:] and 
+        if (prompt_ids.tolist() == _roundtrip_ids(tokenizer, decoded_str, use_tokenizer_template) and 
             filter_word not in decoded_str):
             break
 
@@ -258,7 +290,7 @@ def generate_suffix(models, tokenizer, template_lst, question, target, num_epoch
 
         prompt_replace_lst = cal_replacable_ids(model, system_ids_lst, prompt_ids, repl_ids)
 
-        prompt_ids, loss = select_prompt(models, tokenizer,executor, system_ids_lst, prompt_ids, prompt_replace_lst, filter_word, previous_loss)
+        prompt_ids, loss = select_prompt(models, tokenizer,executor, system_ids_lst, prompt_ids, prompt_replace_lst, filter_word, previous_loss, use_tokenizer_template)
 
         if (loss < best_loss):
             best_loss = loss
@@ -275,4 +307,3 @@ def generate_suffix(models, tokenizer, template_lst, question, target, num_epoch
             print(f"Answer: |{gen_str}|")
 
     return tokenizer.decode(best_prompt_id)
