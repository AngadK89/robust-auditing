+
+def _common_prefix_len(left, right):
+    limit = min(len(left), len(right))
+    for i in range(limit):
+        if left[i] != right[i]:
+            return i
+    return limit
+
+
+def _common_suffix_len(left, right, start=0):
+    limit = min(len(left), len(right)) - start
+    count = 0
+    while count < limit and left[len(left) - 1 - count] == right[len(right) - 1 - count]:
+        count += 1
+    return count
+
+
+def _changed_span(before_ids, after_ids):
+    start = _common_prefix_len(before_ids, after_ids)
